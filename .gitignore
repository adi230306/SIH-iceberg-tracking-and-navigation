# Stale nested clone left over from an earlier layout. It has its own
# .git (so git would add it as a broken submodule gitlink) and holds a
# copy of .cdsapirc. Everything real now lives at the repo root.
SIH-iceberg-tracking-and-navigation/

# Credentials -- .cdsapirc holds a live CDS API key
.cdsapirc
.copernicusmarine*

# Downloaded ERA5 wind and Copernicus current fields (~750 MB). Not
# committed: they are re-fetched from the APIs on demand, and the
# pipeline rebuilds them from data/byu when they are absent.
# The trailing /* matters: excluding the DIRECTORY itself would stop git
# from ever looking inside it, so the negation below could not re-include
# anything.
data/cache/*
# ...except the pooled dataset. It is a few hundred KB, and with it
# present the pipeline short-circuits before any API call -- which is
# what lets a deployed copy run with no CDS or Copernicus credentials.
!data/cache/real_track_pooled_byu_*.csv

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
